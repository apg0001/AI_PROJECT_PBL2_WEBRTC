# TURN 설정 (#38). 이 파일을 server/.env 로 복사해 값을 채운다. server/.env 는 git에 올라가지 않는다.
# 바꾼 뒤에는 npm start 를 다시 실행한다.

# Cloudflare Realtime TURN (매달 1,000 GB 무료). 대시보드 > Realtime > TURN Server에서 키를 만들면 나오는 두 값
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# 발급하는 접속 정보 유효기간(초). 기본 4시간
# TURN_TTL=14400

# 또는 고정 TURN. 예: Metered Open Relay (매달 20 GB 무료, 카드 등록 없음).
#   dashboard.metered.ca > TURN Server > Add Credential 에 나오는 주소를 쉼표로 잇고 username, credential을 넣는다
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
